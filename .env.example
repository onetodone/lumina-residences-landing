PORT=3000
# Public site URL, used for metadataBase (Open Graph / Twitter image resolution).
# No real domain exists yet for this portfolio project — leave unset locally.
NEXT_PUBLIC_SITE_URL=https://example.com
# Mapbox GL access token for the Location cell's map (src/components/cells/LocationMap.tsx).
# Get one at https://account.mapbox.com/access-tokens/ — without it the cell falls back to a static gradient.
NEXT_PUBLIC_MAPBOX_TOKEN=
